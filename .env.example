# Template only. Use new values in your private local .env file.
ACTIVE_RESPONSE_TOKEN=replace-with-a-long-random-token
THEHIVE_API_KEY=replace-with-a-new-thehive-api-key

# Wazuh and dashboard credentials — replace with strong, matching values
WAZUH_INDEXER_PASSWORD=replace-with-your-indexer-password
WAZUH_API_PASSWORD=replace-with-your-wazuh-api-password
DASHBOARD_PASSWORD=replace-with-your-dashboard-password

# Adjust for your local installation if you use the Compose template
WAZUH_CERTS_DIR=/path/to/your/wazuh/certificates
DASHBOARD_USERNAME=replace-with-your-dashboard-username
